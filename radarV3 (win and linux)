    def on_footstep_toggled(self, state):
        self.config.settings["show_footstep_lock"] = (state == QtCore.Qt.Checked)
        self.config.save()

    def on_adaptive_toggled(self, state):
        self.config.settings["adaptive_gain"] = (state == QtCore.Qt.Checked)
        self.config.save()

    def on_arrows_toggled(self, state):
        self.config.settings["use_arrows"] = (state == QtCore.Qt.Checked)
        self.config.save()

    def on_set_default_device(self):
        new_device = self.audio_processor.set_default_device()
        self.refresh_devices()
        if new_device:
            self.device_combo.blockSignals(True)
            for idx, dev in enumerate(self.audio_devices):
                if dev.name == new_device.name:
                    self.device_combo.setCurrentIndex(idx)
                    break
            self.device_combo.blockSignals(False)
            self.dev_label.setText(f"Active Device: {new_device.name}  [Auto-Selected]")
        else:
            self.dev_label.setText("No suitable loopback device found.")

    def refresh_devices(self):
        self.device_combo.blockSignals(True)
        self.device_combo.clear()
        self.audio_devices = []
        try:
            mics = sc.all_microphones(include_loopback=True)
            for m in mics:
                self.audio_devices.append(m)
                is_loop  = getattr(m, 'isloopback', False) or "monitor" in m.name.lower()
                prefix   = "[LOOPBACK] " if is_loop else "[INPUT] "
                self.device_combo.addItem(f"{prefix}{m.name}")
        except Exception as e:
            print(f"[SYSTEM] Error loading audio streams: {e}")

        active_index = 0
        if self.audio_processor.device:
            for idx, dev in enumerate(self.audio_devices):
                if dev.name == self.audio_processor.device.name:
                    active_index = idx
                    break
        self.device_combo.setCurrentIndex(active_index)
        self.device_combo.blockSignals(False)

    def _refresh_and_keep_selection(self):
        self.refresh_devices()
        if self.audio_processor.device:
            self.dev_label.setText(f"Active Device: {self.audio_processor.device.name}")

    def on_device_changed(self, index):
        if 0 <= index < len(self.audio_devices):
            selected_device = self.audio_devices[index]
            self.audio_processor.change_device(selected_device)
            self.dev_label.setText(f"Active Device: {selected_device.name}")

    def handle_auto_device_switch(self, new_device):
        self.device_combo.blockSignals(True)
        self.refresh_devices()
        for idx, dev in enumerate(self.audio_devices):
            if dev.name == new_device.name:
                self.device_combo.setCurrentIndex(idx)
                break
        self.dev_label.setText(f"Active Device: {new_device.name}")
        self.device_combo.blockSignals(False)

    def choose_color(self):
        current_color = QtGui.QColor(self.config.settings["dot_color"])
        color = QtWidgets.QColorDialog.getColor(current_color, self, "Select Radar Colors")
        if color.isValid():
            self.config.settings["dot_color"] = color.name()
            self.config.save()

    def on_display_mode_changed(self, mode):
        self.config.settings["display_mode"] = mode
        self.config.save()

    def apply_preset(self, name):
        preset = PRESETS.get(name, {})
        for k, v in preset.items():
            self.config.settings[k] = v
        self.config.save()
        self.refresh_all_ui()

    def reset_to_defaults(self):
        for k, v in self.config.defaults.items():
            self.config.settings[k] = v
        self.config.save()
        self.refresh_all_ui()

    def refresh_all_ui(self):
        for key, (slider, val_lbl, factor, decimals) in self.slider_refs.items():
            val = self.config.settings.get(key, 0)
            slider.blockSignals(True)
            slider.setValue(int(val * factor))
            slider.blockSignals(False)
            val_lbl.setText(f"{val:.{decimals}f}")

        self.footstep_cb.blockSignals(True)
        self.footstep_cb.setChecked(self.config.settings.get("show_footstep_lock", True))
        self.footstep_cb.blockSignals(False)

        self.adaptive_cb.blockSignals(True)
        self.adaptive_cb.setChecked(self.config.settings.get("adaptive_gain", True))
        self.adaptive_cb.blockSignals(False)

        self.arrows_cb.blockSignals(True)
        self.arrows_cb.setChecked(self.config.settings.get("use_arrows", True))
        self.arrows_cb.blockSignals(False)

        mode = self.config.settings.get("display_mode", "hud")
        self.mode_hud_rb.blockSignals(True)
        self.mode_radar_rb.blockSignals(True)
        self.mode_hud_rb.setChecked(mode == "hud")
        self.mode_radar_rb.setChecked(mode == "radar")
        self.mode_hud_rb.blockSignals(False)
        self.mode_radar_rb.blockSignals(False)

    def closeEvent(self, event):
        self.audio_processor.stop()
        self.overlay_window.close()
        QtWidgets.QApplication.quit()


class OverlayWindow(QtWidgets.QWidget):
    """Transparent click-through gameplay HUD displaying directional dots and footstep markers."""
    def __init__(self, audio_processor, config):
        super().__init__()
        self.audio_processor = audio_processor
        self.config          = config
        self.pulses          = deque()
        self.radar_sweep_angle = -90.0

        # Pre-allocated reusable graphics elements to eliminate heap churn
        self.cached_point = QtCore.QPointF()
        self.cached_rect  = QtCore.QRectF()
        self.arrow_poly   = QtGui.QPolygonF([QtCore.QPointF(), QtCore.QPointF(), QtCore.QPointF()])

        self.init_overlay()

        self.timer = QtCore.QTimer(self)
        self.timer.timeout.connect(self.tick)
        # Cap overlay ticks to 16ms (~60Hz) to save desktop composition and GPU overhead
        self.timer.start(16)

    def init_overlay(self):
        flags = (
            QtCore.Qt.WindowStaysOnTopHint |
            QtCore.Qt.FramelessWindowHint  |
            QtCore.Qt.WindowTransparentForInput |
            QtCore.Qt.ToolTip
        )
        if IS_LINUX:
            flags |= QtCore.Qt.BypassWindowManagerHint

        self.setWindowFlags(flags)
        self.setAttribute(QtCore.Qt.WA_TranslucentBackground,      True)
        self.setAttribute(QtCore.Qt.WA_TransparentForMouseEvents,  True)
        self.setAttribute(QtCore.Qt.WA_ShowWithoutActivating,      True)

        screen = QtWidgets.QApplication.primaryScreen().geometry()
        self.setGeometry(screen)

        if IS_WINDOWS:
            try:
                import ctypes
                hwnd   = int(self.winId())
                user32 = ctypes.windll.user32
                styles = user32.GetWindowLongW(hwnd, -20)
                user32.SetWindowLongW(hwnd, -20, styles | 0x00000020 | 0x00080000)
            except Exception as e:
                print(f"[SYSTEM] Win32 style exception: {e}")

        self.show()

    def tick(self):
        max_trail_age = 15
        while self.pulses and self.pulses[0].age > max_trail_age:
            self.pulses.popleft()

        for p in self.pulses:
            p.age += 1

        intensity = self.audio_processor.current_intensity
        if intensity > 0.01:
            self.pulses.append(SoundPulse(
                direction    = self.audio_processor.current_direction,
                intensity    = intensity,
                depth        = self.audio_processor.current_depth,
                is_footstep  = self.audio_processor.footstep_detected,
                max_age      = max_trail_age
            ))

        # Balanced speed adjustment matching the new 60Hz intervals
        self.radar_sweep_angle = (self.radar_sweep_angle + 3.6) % 360.0
        self.update()

    def paintEvent(self, event):
        painter = QtGui.QPainter(self)
        painter.setRenderHint(QtGui.QPainter.Antialiasing)

        if self.config.settings.get("display_mode", "hud") == "radar":
            self.paint_radar_mode(painter)
        else:
            self.paint_hud_mode(painter)

    def paint_hud_mode(self, painter):
        settings         = self.config.settings
        width            = self.width()
        height           = self.height()

        hud_center_x     = width  / 2
        hud_center_y     = height * settings["overlay_y_pos"]
        hud_active_width = width  * settings["hud_width_ratio"]
        depth_scale      = 120.0

        subtle_pen = QtGui.QPen(QtGui.QColor(255, 255, 255, 10))
        painter.setPen(subtle_pen)
        painter.drawLine(
            int(hud_center_x - hud_active_width / 2), int(hud_center_y),
            int(hud_center_x + hud_active_width / 2), int(hud_center_y)
        )

        base_color = QtGui.QColor(settings["dot_color"])

        for pulse in self.pulses:
            age_factor = 1.0 - (pulse.age / pulse.max_age)
            alpha      = int(204 * age_factor * pulse.intensity) # Optimized alpha baseline
            if alpha <= 0: continue

            pulse_color = QtGui.QColor(255, 69, 0) if pulse.depth < -0.15 else QtGui.QColor(base_color)
            pulse_color.setAlpha(alpha)

            x_pos          = hud_center_x + (pulse.direction * (hud_active_width / 2))
            y_pos          = hud_center_y + (-1.0 * pulse.depth * depth_scale)
            current_dot_size = 22.0 * (0.5 + 0.5 * age_factor) * (0.8 + 0.4 * pulse.intensity)

            is_panned = abs(pulse.direction) > 0.15

            if settings.get("use_arrows", True) and is_panned:
                painter.setPen(QtCore.Qt.NoPen)
                painter.setBrush(QtGui.QBrush(pulse_color))

                arrow_size = 20.0 * (0.5 + 0.5 * age_factor) * (0.8 + 0.4 * pulse.intensity)

                if pulse.direction < 0:
                    self.arrow_poly[0] = QtCore.QPointF(x_pos - arrow_size,       y_pos)
                    self.arrow_poly[1] = QtCore.QPointF(x_pos + arrow_size * 0.4, y_pos - arrow_size * 0.55)
                    self.arrow_poly[2] = QtCore.QPointF(x_pos + arrow_size * 0.4, y_pos + arrow_size * 0.55)
                else:
                    self.arrow_poly[0] = QtCore.QPointF(x_pos + arrow_size,       y_pos)
                    self.arrow_poly[1] = QtCore.QPointF(x_pos - arrow_size * 0.4, y_pos - arrow_size * 0.55)
                    self.arrow_poly[2] = QtCore.QPointF(x_pos - arrow_size * 0.4, y_pos + arrow_size * 0.55)

                painter.drawPolygon(self.arrow_poly)
            else:
                painter.setBrush(QtCore.Qt.NoBrush)
                glow_pen = QtGui.QPen(pulse_color)
                glow_pen.setWidth(2)
                painter.setPen(glow_pen)
                self.cached_point.setX(x_pos)
                self.cached_point.setY(y_pos)
                painter.drawEllipse(self.cached_point, current_dot_size, current_dot_size)

                pulse_color.setAlpha(int(alpha * 0.7))
                painter.setBrush(QtGui.QBrush(pulse_color))
                painter.setPen(QtCore.Qt.NoPen)
                painter.drawEllipse(self.cached_point, current_dot_size * 0.45, current_dot_size * 0.45)

            if pulse.is_footstep and settings["show_footstep_lock"]:
                step_color = QtGui.QColor(57, 255, 20, alpha)
                painter.setBrush(QtCore.Qt.NoBrush)
                step_pen = QtGui.QPen(step_color)
                step_pen.setWidth(2)
                painter.setPen(step_pen)

                target_radius = current_dot_size * 1.6
                self.cached_point.setX(x_pos)
                self.cached_point.setY(y_pos)
                painter.drawEllipse(self.cached_point, target_radius, target_radius)

                ix, iy = int(x_pos), int(y_pos)
                ir = int(target_radius)
                painter.drawLine(ix - ir - 4, iy, ix - ir + 2, iy)
                painter.drawLine(ix + ir - 2, iy, ix + ir + 4, iy)
                painter.drawLine(ix, iy - ir - 4, ix, iy - ir + 2)
                painter.drawLine(ix, iy - ir - 2, ix, iy + ir + 4)

                font = painter.font()
                font.setPointSize(9)
                font.setBold(True)
                painter.setFont(font)
                painter.setPen(step_color)
                self.cached_rect.setRect(x_pos - 80, y_pos - target_radius - 22, 160, 18)
                painter.drawText(self.cached_rect, QtCore.Qt.AlignCenter, "WALKING / STEP")

    def paint_radar_mode(self, painter):
        settings  = self.config.settings
        width     = self.width()
        height    = self.height()

        radar_r   = int(settings.get("radar_size", 140))
        cx        = int(width  * settings.get("radar_x_pos", 0.85))
        cy        = int(height * settings.get("radar_y_pos", 0.85))

        self.cached_point.setX(cx)
        self.cached_point.setY(cy)

        bg_color = QtGui.QColor(0, 12, 4, 200)
        painter.setBrush(QtGui.QBrush(bg_color))
        painter.setPen(QtCore.Qt.NoPen)
        painter.drawEllipse(self.cached_point, radar_r, radar_r)

        ring_pen = QtGui.QPen(QtGui.QColor(0, 180, 60, 55))
        painter.setPen(ring_pen)
        painter.setBrush(QtCore.Qt.NoBrush)
        painter.drawEllipse(self.cached_point, radar_r * 0.33, radar_r * 0.33)
        painter.drawEllipse(self.cached_point, radar_r * 0.66, radar_r * 0.66)
        painter.drawEllipse(self.cached_point, radar_r, radar_r)

        cross_pen = QtGui.QPen(QtGui.QColor(0, 180, 60, 40))
        painter.setPen(cross_pen)
        painter.drawLine(cx - radar_r, cy, cx + radar_r, cy)
        painter.drawLine(cx, cy - radar_r, cx, cy + radar_r)

        border_pen = QtGui.QPen(QtGui.QColor(0, 220, 80, 180))
        border_pen.setWidth(2)
        painter.setPen(border_pen)
        painter.drawEllipse(self.cached_point, radar_r, radar_r)

        sweep_deg  = self.radar_sweep_angle
        cone_span  = 60
        grad       = QtGui.QConicalGradient(self.cached_point, -sweep_deg)
        grad.setColorAt(0.0,  QtGui.QColor(0, 255, 80, 130))
        grad.setColorAt(cone_span / 360.0, QtGui.QColor(0, 255, 80, 0))
        grad.setColorAt(1.0,  QtGui.QColor(0, 255, 80, 0))
        painter.setBrush(QtGui.QBrush(grad))
        painter.setPen(QtCore.Qt.NoPen)

        painter.save()
        clip_path = QtGui.QPainterPath()
        clip_path.addEllipse(self.cached_point, radar_r, radar_r)
        painter.setClipPath(clip_path)
        self.cached_rect.setRect(cx - radar_r, cy - radar_r, radar_r * 2, radar_r * 2)
        painter.drawPie(self.cached_rect, int((-sweep_deg) * 16), int(-cone_span * 16))
        painter.restore()

        sweep_rad  = math.radians(sweep_deg)
        tip_x      = cx + radar_r * math.cos(sweep_rad)
        tip_y      = cy + radar_r * math.sin(sweep_rad)
        tip_pen    = QtGui.QPen(QtGui.QColor(0, 255, 80, 220))
        tip_pen.setWidth(2)
        painter.setPen(tip_pen)
        painter.drawLine(cx, cy, int(tip_x), int(tip_y))

        for pulse in self.pulses:
            age_factor = 1.0 - (pulse.age / pulse.max_age)
            alpha      = int(200 * age_factor * (0.5 + 0.5 * pulse.intensity))
            if alpha <= 0: continue

            bx = cx + (radar_r * 0.82) * pulse.direction
            by = cy - (radar_r * 0.70) * pulse.depth

            dx, dy = bx - cx, by - cy
            dist   = math.sqrt(dx * dx + dy * dy)
            if dist > radar_r * 0.90:
                scale  = (radar_r * 0.90) / dist
                bx     = cx + dx * scale
                by     = cy + dy * scale

            blip_r = 4.0 + 4.0 * pulse.intensity * age_factor

            if pulse.depth < -0.15:
                blip_col = QtGui.QColor(255, 80, 0, alpha)
            elif pulse.is_footstep and settings["show_footstep_lock"]:
                blip_col = QtGui.QColor(57, 255, 20, alpha)
            else:
                blip_col = QtGui.QColor(0, 255, 100, alpha)

            painter.setBrush(QtGui.QBrush(blip_col))
            painter.setPen(QtCore.Qt.NoPen)
            self.cached_point.setX(bx)
            self.cached_point.setY(by)
            painter.drawEllipse(self.cached_point, blip_r, blip_r)

            blip_col.setAlpha(int(alpha * 0.35))
            painter.setBrush(QtGui.QBrush(blip_col))
            painter.drawEllipse(self.cached_point, blip_r * 2.5, blip_r * 2.5)

        label_font = painter.font()
        label_font.setPointSize(7)
        label_font.setBold(True)
        painter.setFont(label_font)
        painter.setPen(QtGui.QColor(0, 200, 80, 160))
        self.cached_rect.setRect(cx - radar_r, cy + radar_r + 4, radar_r * 2, 14)
        painter.drawText(self.cached_rect, QtCore.Qt.AlignCenter, "SPATIAL RADAR")

        label_pen = QtGui.QPen(QtGui.QColor(0, 160, 60, 120))
        painter.setPen(label_pen)
        offset = radar_r - 12
        painter.drawText(cx - 5,        cy - offset - 2, 12, 12, QtCore.Qt.AlignCenter, "N")
        painter.drawText(cx - 5,        cy + offset - 12, 12, 12, QtCore.Qt.AlignCenter, "S")
        painter.drawText(cx - offset - 2, cy - 6,          12, 12, QtCore.Qt.AlignCenter, "W")
        painter.drawText(cx + offset - 10, cy - 6,          12, 12, QtCore.Qt.AlignCenter, "E")


def run_app():
    QtWidgets.QApplication.setAttribute(QtCore.Qt.AA_EnableHighDpiScaling, True)
    QtWidgets.QApplication.setAttribute(QtCore.Qt.AA_UseHighDpiPixmaps,    True)

    app = QtWidgets.QApplication(sys.argv)

    config          = Config()
    audio_processor = AudioProcessor(config)
    audio_processor.start()

    overlay      = OverlayWindow(audio_processor, config)
    settings_gui = SettingsWindow(config, audio_processor, overlay)
    settings_gui.show()

    sys.exit(app.exec_())


if __name__ == "__main__":
    run_app()
