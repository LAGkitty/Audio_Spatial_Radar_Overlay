    def refresh_devices(self):
        """Discovers sound devices and registers them into the selection GUI."""
        self.device_combo.blockSignals(True)
        self.device_combo.clear()
        self.audio_devices = []
        
        try:
            mics = sc.all_microphones(include_loopback=True)
            for m in mics:
                self.audio_devices.append(m)
                is_loop = getattr(m, 'isloopback', False)
                prefix = "[SYSTEM LOOPBACK] " if is_loop else "[MIC] "
                self.device_combo.addItem(f"{prefix}{m.name}")
        except Exception as e:
            print(f"[SYSTEM] Could not resolve audio device list: {e}")

        # Highlight currently active hardware device in menu selection
        active_index = 0
        if self.audio_processor.device:
            for idx, dev in enumerate(self.audio_devices):
                if dev.name == self.audio_processor.device.name and getattr(dev, 'isloopback', False) == getattr(self.audio_processor.device, 'isloopback', False):
                    active_index = idx
                    break
        
        self.device_combo.setCurrentIndex(active_index)
        self.device_combo.blockSignals(False)

    def on_device_changed(self, index):
        """Triggers manual routing changes when user manually changes selections."""
        if 0 <= index < len(self.audio_devices):
            selected_device = self.audio_devices[index]
            self.audio_processor.change_device(selected_device)
            self.dev_label.setText(f"Source: {selected_device.name}")

    def handle_auto_device_switch(self, new_device):
        """Syncs GUI combobox states when the core processor switches due to Windows hardware hotplugging."""
        self.device_combo.blockSignals(True)
        
        # Re-populate choices in case devices were added/removed
        self.refresh_devices()
        
        for idx, dev in enumerate(self.audio_devices):
            if dev.name == new_device.name and getattr(dev, 'isloopback', False) == getattr(new_device, 'isloopback', False):
                self.device_combo.setCurrentIndex(idx)
                break
                
        self.dev_label.setText(f"Source: {new_device.name}")
        self.device_combo.blockSignals(False)

    def update_footstep_focus(self, state):
        self.config.settings["footstep_focus"] = bool(state)
        self.config.save()

    def update_adaptive_gate(self, state):
        self.config.settings["adaptive_gate"] = bool(state)
        self.config.save()

    def update_panned_text(self, state):
        self.config.settings["show_text_panned"] = bool(state)
        self.config.save()

    def choose_color(self):
        current_color = QtGui.QColor(self.config.settings["dot_color"])
        color = QtWidgets.QColorDialog.getColor(current_color, self, "Select HUD Indicator Color")
        if color.isValid():
            hex_color = color.name()
            self.config.settings["dot_color"] = hex_color
            self.config.save()

    def closeEvent(self, event):
        # Graceful app shutdown
        self.audio_processor.stop()
        self.overlay_window.close()
        QtWidgets.QApplication.quit()

class OverlayWindow(QtWidgets.QWidget):
    """Transparent click-through desktop overlay displaying reactive, glowing sound direction arrows."""
    def __init__(self, audio_processor, config):
        super().__init__()
        self.audio_processor = audio_processor
        self.config = config
        self.pulses = deque()  # Store historical sound pulses for trails
        
        self.init_overlay()
        
        # High refresh render loop tick timer
        self.timer = QtCore.QTimer(self)
        self.timer.timeout.connect(self.tick)
        self.timer.start(8)  # Target ~120Hz refresh limits

    def init_overlay(self):
        # Transparent, click-through, always-on-top desktop overlay configurations
        flags = QtCore.Qt.FramelessWindowHint | QtCore.Qt.WindowStaysOnTopHint | QtCore.Qt.Tool | QtCore.Qt.WindowTransparentForInput
        self.setWindowFlags(flags)
        self.setAttribute(QtCore.Qt.WA_TranslucentBackground, True)
        self.setAttribute(QtCore.Qt.WA_TransparentForMouseEvents, True)
        
        # Span across main monitor layout boundaries
        screen = QtWidgets.QApplication.primaryScreen().geometry()
        self.setGeometry(screen)
        self.show()

    def tick(self):
        # Age out old pulse events for trail fade-out
        for p in list(self.pulses):
            p.age += 1
            if p.age > self.config.settings["trail_length"]:
                self.pulses.popleft()
                
        # Inject current sound tracking vector frame
        intensity = self.audio_processor.current_intensity
        if intensity > 0.01:
            self.pulses.append(SoundPulse(
                direction=self.audio_processor.current_direction,
                intensity=intensity,
                max_age=int(self.config.settings["trail_length"])
            ))
            
        self.update()  # Force canvas update events

    def paintEvent(self, event):
        painter = QtGui.QPainter(self)
        painter.setRenderHint(QtGui.QPainter.Antialiasing)
        
        settings = self.config.settings
        width = self.width()
        height = self.height()
        
        # Determine geometric HUD layout positions
        hud_center_x = width / 2
        hud_y = height * settings["overlay_y_pos"]
        hud_active_width = width * settings["hud_width_ratio"]
        
        # Draw a sleek, faint horizontal layout guide line
        subtle_pen = QtGui.QPen(QtGui.QColor(255, 255, 255, 12))
        subtle_pen.setWidth(2)
        painter.setPen(subtle_pen)
        painter.drawLine(
            int(hud_center_x - hud_active_width / 2), int(hud_y), 
            int(hud_center_x + hud_active_width / 2), int(hud_y)
        )
        
        # Draw glowing static coordinate target center reference point
        painter.setBrush(QtGui.QBrush(QtGui.QColor(0, 240, 255, 30)))
        painter.setPen(QtCore.Qt.NoPen)
        painter.drawEllipse(QtCore.QPointF(hud_center_x, hud_y), 4.0, 4.0)
        
        base_color = QtGui.QColor(settings["dot_color"])
        
        # Draw historical glowing vectors backwards from decay array
        for pulse in self.pulses:
            age_factor = 1.0 - (pulse.age / pulse.max_age)
            alpha = int(255 * age_factor * pulse.intensity * settings["opacity"])
            alpha = max(0, min(255, alpha))
            
            pulse_color = QtGui.QColor(base_color)
            pulse_color.setAlpha(alpha)
            
            # Translate panning vectors onto pixel screen dimensions
            x_pos = hud_center_x + (pulse.direction * (hud_active_width / 2))
            
            # Paint glow ring
            painter.setBrush(QtCore.Qt.NoBrush)
            glow_pen = QtGui.QPen(pulse_color)
            glow_pen.setWidth(2)
            painter.setPen(glow_pen)
            
            current_dot_size = settings["dot_size"] * (0.4 + 0.6 * age_factor) * (0.8 + 0.5 * pulse.intensity)
            painter.drawEllipse(QtCore.QPointF(x_pos, hud_y), current_dot_size, current_dot_size)
            
            # Paint solid inner core indicator
            solid_color = QtGui.QColor(pulse_color)
            solid_color.setAlpha(int(alpha * 0.7))
            painter.setBrush(QtGui.QBrush(solid_color))
            painter.setPen(QtCore.Qt.NoPen)
            painter.drawEllipse(QtCore.QPointF(x_pos, hud_y), current_dot_size * 0.4, current_dot_size * 0.4)
            
        # Draw dynamic text alerts for heavy left/right sound panning
        if settings["show_text_panned"] and len(self.pulses) > 0:
            last_pulse = self.pulses[-1]
            if last_pulse.intensity > 0.15 and abs(last_pulse.direction) > 0.5:
                direction_str = "LEFT" if last_pulse.direction < 0 else "RIGHT"
                
                text_color = QtGui.QColor(base_color)
                text_color.setAlpha(int(255 * last_pulse.intensity * settings["opacity"]))
                
                painter.setPen(QtGui.QPen(text_color))
                font = painter.font()
                font.setPointSize(12)
                font.setBold(True)
                font.setLetterSpacing(QtGui.QFont.PercentageSpacing, 110)
                painter.setFont(font)
                
                # Center text layout bounds underneath respective target points
                text_x_pos = hud_center_x + (last_pulse.direction * (hud_active_width / 2)) - 50
                rect = QtCore.QRectF(text_x_pos, hud_y + settings["dot_size"] + 8, 100, 25)
                painter.drawText(rect, QtCore.Qt.AlignCenter, f"<< {direction_str} >>")

def run_app():
    # Force platform settings for proper screen scale support
    QtWidgets.QApplication.setAttribute(QtCore.Qt.AA_EnableHighDpiScaling, True)
    QtWidgets.QApplication.setAttribute(QtCore.Qt.AA_UseHighDpiPixmaps, True)
    
    app = QtWidgets.QApplication(sys.argv)
    
    print("[SYSTEM] High-Refresh-Rate Optimized Trail Radar Initialized.")
    config = Config()
    
    # Run the background processor
    audio_processor = AudioProcessor(config)
    audio_processor.start()
    
    # Instantiate the transparent overlay screen
    overlay = OverlayWindow(audio_processor, config)
    
    # Instantiate calibration controller dashboard
    settings_gui = SettingsWindow(config, audio_processor, overlay)
    settings_gui.show()
    
    sys.exit(app.exec_())

if __name__ == "__main__":
    run_app()
