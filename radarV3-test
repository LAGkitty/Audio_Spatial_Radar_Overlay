class Config:
    """Handles loading, saving, and verifying advanced visualization settings."""
    def __init__(self, filename="audio_radar_settings.json"):
        self.filename = filename
        self.defaults = {
            "sensitivity": 8.0,
            "noise_gate": 0.015,
            "adaptive_gate": True,
            "footstep_focus": True,
            "dot_color": "#00f0ff",  # Cyberpunk Neon Cyan
            "dot_size": 22,
            "smoothing": 0.75,
            "opacity": 0.85,
            "overlay_y_pos": 0.15,   # 15% from the top of the screen
            "hud_width_ratio": 0.35, # 35% of screen width (compact combat HUD)
            "trail_length": 15,       # Number of fading history frames
            "show_text_panned": True
        }
        self.settings = self.load()

    def load(self):
        if os.path.exists(self.filename):
            try:
                with open(self.filename, 'r') as f:
                    data = json.load(f)
                    # Merge default keys if missing
                    for k, v in self.defaults.items():
                        if k not in data:
                            data[k] = v
                    return data
            except Exception as e:
                print(f"[SYSTEM] Warning: Error loading config, reverting to defaults: {e}")
                return self.defaults.copy()
        return self.defaults.copy()

    def save(self):
        try:
            with open(self.filename, 'w') as f:
                json.dump(self.settings, f, indent=4)
        except Exception as e:
            print(f"[SYSTEM] Error saving settings: {e}")

class SoundPulse:
    """Represents a historic directional sound event for smooth glow trails."""
    def __init__(self, direction, intensity, max_age):
        self.direction = direction  # -1.0 (Left) to 1.0 (Right)
        self.intensity = intensity  # Normalized volume
        self.age = 0
        self.max_age = max_age

class AudioProcessor:
    """Captures system desktop audio, applies footstep frequency filtering, and tracks active output."""
    def __init__(self, config):
        self.config = config
        self.samplerate = 44100
        self.blocksize = 1024  # Balance between latency and spectral resolution
        
        self.running = False
        self.current_direction = 0.0
        self.current_intensity = 0.0
        self.ambient_noise_floor = 0.005  # Baseline ambient floor
        
        self.device = None
        self.on_device_auto_changed_callback = None
        self._find_wasapi_loopback()

    def _find_wasapi_loopback(self):
        """Finds the current active system playback device's loopback recorder dynamically."""
        try:
            # 1. Grab the currently active default speaker on Windows
            default_speaker = sc.default_speaker()
            print(f"[SYSTEM] Detected Windows Active Playback Device: {default_speaker.name}")
            
            # 2. Search for the corresponding loopback microphone matching the name
            mics = sc.all_microphones(include_loopback=True)
            for m in mics:
                if getattr(m, 'isloopback', False) and (default_speaker.name in m.name or m.name in default_speaker.name):
                    self.device = m
                    print(f"[SYSTEM] Automatically bound loopback recorder to: {self.device.name}")
                    return

            # Fallback 1: Try targeting loopback via direct matching query
            try:
                self.device = sc.get_microphone(id=default_speaker.name, include_loopback=True)
                print(f"[SYSTEM] Fallback 1 matched loopback: {self.device.name}")
                return
            except Exception:
                pass

            # Fallback 2: Pick the first available loopback recorder
            for m in mics:
                if getattr(m, 'isloopback', False):
                    self.device = m
                    print(f"[SYSTEM] Fallback 2 selected first loopback: {self.device.name}")
                    return

            # Fallback 3: Use the default standard microphone
            self.device = sc.default_microphone()
            print(f"[SYSTEM] Fallback 3 (Loopback unavailable, capturing Mic): {self.device.name}")
        except Exception as e:
            print(f"[ERROR] Failed to find active playback loopback device: {e}")
            self.device = None

    def start(self):
        if self.running or self.device is None:
            return
        self.running = True
        self.thread = threading.Thread(target=self._capture_loop, daemon=True)
        self.thread.start()

    def stop(self):
        self.running = False
        if hasattr(self, 'thread') and self.thread.is_alive():
            self.thread.join(timeout=1.0)

    def change_device(self, new_device):
        """Changes the audio device dynamically and restarts the thread stream."""
        print(f"[SYSTEM] Changing capture target to: {new_device.name}")
        self.stop()
        self.device = new_device
        self.start()

    def _capture_loop(self):
        """Continuously reads audio, tracks device shifts, filters footsteps, and extracts direction."""
        while self.running:
            try:
                # Hotplug auto-detection: If the Windows default playback speaker shifts, auto-migrate our stream
                try:
                    current_system_default = sc.default_speaker()
                    if self.device and getattr(self.device, 'isloopback', False):
                        if current_system_default.name not in self.device.name and self.device.name not in current_system_default.name:
                            print(f"[SYSTEM] Windows Playback Device Change Detected! Auto-migrating from '{self.device.name}' to '{current_system_default.name}'")
                            self._find_wasapi_loopback()
                            if self.on_device_auto_changed_callback and self.device:
                                self.on_device_auto_changed_callback(self.device)
                except Exception:
                    pass

                if self.device is None:
                    time.sleep(0.5)
                    continue
                
                # Open system loopback recorder
                with self.device.recorder(samplerate=self.samplerate, blocksize=self.blocksize) as recorder:
                    while self.running:
                        # Double-check default speaker changes inside the loop to break out and rebuild if needed
                        try:
                            current_system_default = sc.default_speaker()
                            if self.device and getattr(self.device, 'isloopback', False):
                                if current_system_default.name not in self.device.name and self.device.name not in current_system_default.name:
                                    break  # Breaks inner context loop to trigger reconstruction in outer loop
                        except Exception:
                            pass

                        # Pull audio frames
                        data = recorder.record(numframes=self.blocksize)
                        if len(data) == 0:
                            continue
                        
                        # Split channels
                        if data.shape[1] >= 2:
                            left = data[:, 0]
                            right = data[:, 1]
                        else:
                            left = data[:, 0]
                            right = data[:, 0] # mono fullback

                        # Live Fourier Transform (FFT) analysis to filter specific sound frequencies
                        fft_left = np.fft.rfft(left)
                        fft_right = np.fft.rfft(right)
                        freqs = np.fft.rfftfreq(len(left), d=1.0/self.samplerate)
                        
                        # Apply advanced bi-band equalizer filter
                        if self.config.settings["footstep_focus"]:
                            # Isolate bass thuds (70-220Hz) and gravel/crunch noises (950Hz-3.5kHz)
                            weights = np.ones_like(freqs)
                            weights[freqs < 70] = 0.05
                            weights[(freqs >= 70) & (freqs <= 220)] = 2.2 
                            weights[(freqs > 220) & (freqs < 950)] = 0.4  
                            weights[(freqs >= 950) & (freqs <= 3500)] = 2.5 
                            weights[freqs > 3500] = 0.1 
                            
                            weighted_left = fft_left * weights
                            weighted_right = fft_right * weights
                        else:
                            weighted_left = fft_left
                            weighted_right = fft_right

                        # Extract Root Mean Square (RMS) energy
                        left_rms = np.sqrt(np.mean(np.abs(weighted_left)**2))
                        right_rms = np.sqrt(np.mean(np.abs(weighted_right)**2))
                        total_energy = left_rms + right_rms
                        
                        # Dynamic Ambient Gate tracking
                        if self.config.settings["adaptive_gate"]:
                            if total_energy < self.ambient_noise_floor * 1.5:
                                self.ambient_noise_floor = (0.995 * self.ambient_noise_floor) + (0.005 * total_energy)
                            
                            gate_threshold = self.config.settings["noise_gate"] + (self.ambient_noise_floor * 1.3)
                        else:
                            gate_threshold = self.config.settings["noise_gate"]

                        # Apply gate filter and compute stereo tracking vector
                        if total_energy < gate_threshold:
                            target_intensity = 0.0
                            target_direction = 0.0
                        else:
                            target_intensity = min(1.0, total_energy * self.config.settings["sensitivity"])
                            target_direction = (right_rms - left_rms) / (total_energy + 1e-6)
                            
                            # Accentuate directional extremes
                            target_direction = np.sign(target_direction) * (abs(target_direction) ** 0.8)
                            target_direction = max(-1.0, min(1.0, target_direction))

                        # Smooth interpolation
                        smoothing = self.config.settings["smoothing"]
                        self.current_direction = (self.current_direction * smoothing) + (target_direction * (1.0 - smoothing))
                        self.current_intensity = (self.current_intensity * smoothing) + (target_intensity * (1.0 - smoothing))

            except Exception as e:
                # Yield context if device gets disconnected or blocked
                time.sleep(0.5)

